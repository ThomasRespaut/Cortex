CORTEX_FULLSCREEN=true
CORTEX_PREVIEW_SIZE=900
CORTEX_SCREEN_SIZE=
CORTEX_FRAMELESS=false
CORTEX_HIDE_CURSOR=true
CORTEX_TOUCH_ROTATION=0
CORTEX_TOUCH_ROUND_CLIP=true
CORTEX_TOUCH_EDGE_MARGIN=0
CORTEX_ROUND_MASK=true
CORTEX_TAP_MOVE_LIMIT=14
CORTEX_EMPTY_DOUBLE_TAP_MS=500
CORTEX_EMPTY_DOUBLE_TAP_DISTANCE=36
CORTEX_SCREENSHOT_PATH=
CORTEX_EXIT_AFTER_SCREENSHOT=false
CORTEX_SKIP_CORTEX_LOAD=false
CORTEX_INPUT_MODE=voice
CORTEX_OUTPUT_MODE=voice
CORTEX_LOCAL_MODE=true

# Neo4j
